rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validUsername(value) {
      return value is string && value.matches('^[a-z0-9_]{3,20}$');
    }

    function validUsernameFields() {
      return request.resource.data.username is string
        && (request.resource.data.username == '' || validUsername(request.resource.data.username))
        && request.resource.data.usernameLower == request.resource.data.username.lower();
    }

    function validInviteCode(value) {
      return value is string && value.matches('^[A-HJ-NP-Z2-9]{8}$');
    }

    function ownsUsernameReservation(uid) {
      return request.resource.data.username == ''
        || getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.userId == uid;
    }

    function ownsInviteCodeReservation(uid) {
      return validInviteCode(request.resource.data.inviteCode)
        && getAfter(/databases/$(database)/documents/inviteCodes/$(request.resource.data.inviteCode)).data.userId == uid;
    }

    function validPublicProfileFields() {
      return (!request.resource.data.keys().hasAny(['displayName']) || request.resource.data.displayName is string)
        && (!request.resource.data.keys().hasAny(['avatarConfigurationJson']) || request.resource.data.avatarConfigurationJson is string)
        && (!request.resource.data.keys().hasAny(['country']) || request.resource.data.country is string)
        && (!request.resource.data.keys().hasAny(['city']) || request.resource.data.city is string)
        && (!request.resource.data.keys().hasAny(['gender']) || request.resource.data.gender in ['', 'MALE', 'FEMALE'])
        && (!request.resource.data.keys().hasAny(['memberSinceEpochMs']) || request.resource.data.memberSinceEpochMs is int)
        && (!request.resource.data.keys().hasAny(['statistics']) || (
          request.resource.data.statistics is map
          && request.resource.data.statistics.keys().hasOnly([
            'currentStreakDays', 'bestStreakDays', 'totalExerciseCount',
            'lastSevenDaysExerciseCount', 'totalDurationMs', 'firstTrainingDate',
            'bestExerciseStats'
          ])
        ));
    }

    match /users/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;
      allow create, update: if isOwner(uid)
        && request.resource.data.uid == uid
        && validUsernameFields()
        && ownsUsernameReservation(uid)
        && ownsInviteCodeReservation(uid)
        && getAfter(/databases/$(database)/documents/publicProfiles/$(uid)).data.usernameLower
          == request.resource.data.usernameLower
        && getAfter(/databases/$(database)/documents/publicProfiles/$(uid)).data.inviteCode
          == request.resource.data.inviteCode;
      allow delete: if isOwner(uid)
        && !existsAfter(/databases/$(database)/documents/publicProfiles/$(uid))
        && (
          resource.data.get('usernameLower', '') == ''
          || !existsAfter(/databases/$(database)/documents/usernames/$(resource.data.get('usernameLower', '')))
        )
        && (
          !resource.data.keys().hasAny(['inviteCode'])
          || !existsAfter(/databases/$(database)/documents/inviteCodes/$(resource.data.get('inviteCode', '')))
        );
    }

    match /publicProfiles/{uid} {
      allow get: if isOwner(uid) || (signedIn() && !exists(/databases/$(database)/documents/blockedUsers/$(uid)/users/$(request.auth.uid)));
      allow list: if false;
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'avatarUrl', 'avatarConfigurationJson', 'country', 'city',
          'gender', 'memberSinceEpochMs', 'statistics', 'username', 'usernameLower', 'inviteCode', 'updatedAt'
        ])
        && validPublicProfileFields()
        && request.resource.data.uid == uid
        && validUsernameFields()
        && ownsUsernameReservation(uid)
        && ownsInviteCodeReservation(uid)
        && getAfter(/databases/$(database)/documents/users/$(uid)).data.usernameLower
          == request.resource.data.usernameLower
        && getAfter(/databases/$(database)/documents/users/$(uid)).data.inviteCode
          == request.resource.data.inviteCode;
      allow delete: if isOwner(uid)
        && !existsAfter(/databases/$(database)/documents/users/$(uid))
        && (
          resource.data.get('usernameLower', '') == ''
          || !existsAfter(/databases/$(database)/documents/usernames/$(resource.data.get('usernameLower', '')))
        )
        && (
          !resource.data.keys().hasAny(['inviteCode'])
          || !existsAfter(/databases/$(database)/documents/inviteCodes/$(resource.data.get('inviteCode', '')))
        );
    }

    match /publicProfileCards/{uid} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'username', 'usernameLower', 'avatarConfigurationJson', 'updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.displayName is string
        && request.resource.data.username is string
        && request.resource.data.usernameLower == request.resource.data.username.lower()
        && request.resource.data.avatarConfigurationJson is string
        && existsAfter(/databases/$(database)/documents/users/$(uid))
        && existsAfter(/databases/$(database)/documents/publicProfiles/$(uid));
      allow delete: if isOwner(uid)
        && !existsAfter(/databases/$(database)/documents/users/$(uid))
        && !existsAfter(/databases/$(database)/documents/publicProfiles/$(uid));
    }

    // Public-safe collectible metadata is readable on profiles, but only the owner can publish it.
    match /publicProfileCards/{uid}/collectibles/{collectibleId} {
      function canViewCollectibles() {
        return signedIn()
          && exists(/databases/$(database)/documents/publicProfiles/$(uid))
          && !exists(/databases/$(database)/documents/blockedUsers/$(uid)/users/$(request.auth.uid))
          && !exists(/databases/$(database)/documents/blockedUsers/$(request.auth.uid)/users/$(uid));
      }

      function validCollectible() {
        return request.resource.data.keys().hasOnly([
          'id', 'kind', 'itemType', 'acquiredAtEpochMs', 'senderFirebaseUid',
          'senderName', 'periodKey', 'triggerWorkoutId', 'amount'
        ])
          && request.resource.data.keys().hasAll(['id', 'kind', 'itemType', 'acquiredAtEpochMs'])
          && request.resource.data.id is string
          && request.resource.data.kind in ['GIFT', 'BADGE']
          && request.resource.data.itemType is string
          && request.resource.data.acquiredAtEpochMs is int
          && collectibleId == (request.resource.data.kind == 'GIFT' ? 'gift_' : 'badge_') + request.resource.data.id
          && (!request.resource.data.keys().hasAny(['senderFirebaseUid']) || request.resource.data.senderFirebaseUid is string)
          && (!request.resource.data.keys().hasAny(['senderName']) || (
            request.resource.data.senderName is string && request.resource.data.senderName.size() <= 80
          ))
          && (!request.resource.data.keys().hasAny(['periodKey']) || request.resource.data.periodKey is string)
          && (!request.resource.data.keys().hasAny(['triggerWorkoutId']) || request.resource.data.triggerWorkoutId is int)
          && (!request.resource.data.keys().hasAny(['amount']) || request.resource.data.amount is int)
          && (
            (
              request.resource.data.kind == 'GIFT'
              && request.resource.data.itemType in ['CANDY', 'COFFEE', 'CROISSANT', 'HAMBURGER', 'CAKE']
            )
            || (
              request.resource.data.kind == 'BADGE'
              && request.resource.data.itemType in [
                'WEEKLY_STREAK', 'WEEKLY_CHALLENGE',
                'MONTH_01', 'MONTH_02', 'MONTH_03', 'MONTH_04',
                'MONTH_05', 'MONTH_06', 'MONTH_07', 'MONTH_08',
                'MONTH_09', 'MONTH_10', 'MONTH_11', 'MONTH_12'
              ]
            )
          );
      }

      allow get, list: if canViewCollectibles();
      allow create, update: if isOwner(uid) && validCollectible()
        && exists(/databases/$(database)/documents/publicProfiles/$(uid));
      allow delete: if isOwner(uid);
    }

    match /blockedUsers/{blockerUid}/users/{blockedUid} {
      allow get: if signedIn() && (request.auth.uid == blockerUid || request.auth.uid == blockedUid);
      allow list: if signedIn() && request.auth.uid == blockerUid;
      allow create: if isOwner(blockerUid)
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == blockedUid
        && blockedUid != blockerUid;
      allow update: if false;
      allow delete: if isOwner(blockerUid);
    }
    match /usernames/{username} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && validUsername(username)
        && request.resource.data.keys().hasOnly(['userId'])
        && request.resource.data.userId == request.auth.uid
        && !exists(/databases/$(database)/documents/usernames/$(username))
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.usernameLower == username
        && getAfter(/databases/$(database)/documents/publicProfiles/$(request.auth.uid)).data.usernameLower == username;
      allow update: if false;
      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid
        && !existsAfter(/databases/$(database)/documents/users/$(request.auth.uid))
        && !existsAfter(/databases/$(database)/documents/publicProfiles/$(request.auth.uid));
    }

    match /inviteCodes/{inviteCode} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && validInviteCode(inviteCode)
        && request.resource.data.keys().hasOnly(['userId'])
        && request.resource.data.userId == request.auth.uid
        && !exists(/databases/$(database)/documents/inviteCodes/$(inviteCode))
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.inviteCode == inviteCode
        && getAfter(/databases/$(database)/documents/publicProfiles/$(request.auth.uid)).data.inviteCode == inviteCode;
      allow update: if false;
      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid
        && !existsAfter(/databases/$(database)/documents/users/$(request.auth.uid))
        && !existsAfter(/databases/$(database)/documents/publicProfiles/$(request.auth.uid));
    }

    match /follows/{followId} {
      allow get: if signedIn()
        && (
          !exists(/databases/$(database)/documents/follows/$(followId))
          || resource.data.followerUid == request.auth.uid
          || resource.data.followingUid == request.auth.uid
        );
      allow list: if signedIn()
        && (
          resource.data.followerUid == request.auth.uid
          || resource.data.followingUid == request.auth.uid
        );
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['followerUid', 'followingUid', 'createdAt'])
        && request.resource.data.followerUid == request.auth.uid
        && request.resource.data.followingUid is string
        && request.resource.data.followingUid != request.auth.uid
        && followId == request.resource.data.followerUid + '_' + request.resource.data.followingUid
        && exists(/databases/$(database)/documents/publicProfiles/$(request.resource.data.followingUid))
        && !exists(/databases/$(database)/documents/blockedUsers/$(request.auth.uid)/users/$(request.resource.data.followingUid))
        && !exists(/databases/$(database)/documents/blockedUsers/$(request.resource.data.followingUid)/users/$(request.auth.uid));
      allow update: if false;
      allow delete: if signedIn()
        && (
          resource.data.followerUid == request.auth.uid
          || (
            resource.data.followingUid == request.auth.uid
            && existsAfter(/databases/$(database)/documents/blockedUsers/$(request.auth.uid)/users/$(resource.data.followerUid))
          )
        );
    }

    // Public relationship projections let signed-in users inspect another profile's lists
    // without granting access to arbitrary documents in the internal follows collection.
    match /publicFollowing/{profileUid}/users/{followingUid} {
      allow get, list: if signedIn()
        && !exists(/databases/$(database)/documents/blockedUsers/$(profileUid)/users/$(request.auth.uid));
      allow create: if signedIn()
        && request.auth.uid == profileUid
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == followingUid
        && existsAfter(/databases/$(database)/documents/follows/$(profileUid + '_' + followingUid))
        && getAfter(/databases/$(database)/documents/follows/$(profileUid + '_' + followingUid)).data.followingUid == followingUid;
      allow update: if false;
      allow delete: if signedIn()
        && (request.auth.uid == profileUid || request.auth.uid == followingUid)
        && !existsAfter(/databases/$(database)/documents/follows/$(profileUid + '_' + followingUid));
    }

    match /publicFollowers/{profileUid}/users/{followerUid} {
      allow get, list: if signedIn()
        && !exists(/databases/$(database)/documents/blockedUsers/$(profileUid)/users/$(request.auth.uid));
      allow create: if signedIn()
        && (request.auth.uid == followerUid || request.auth.uid == profileUid)
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == followerUid
        && existsAfter(/databases/$(database)/documents/follows/$(followerUid + '_' + profileUid))
        && getAfter(/databases/$(database)/documents/follows/$(followerUid + '_' + profileUid)).data.followingUid == profileUid;
      allow update: if false;
      allow delete: if signedIn()
        && (request.auth.uid == followerUid || request.auth.uid == profileUid)
        && !existsAfter(/databases/$(database)/documents/follows/$(followerUid + '_' + profileUid));
    }
    match /feedEvents/{eventId} {
      // Each author is queried separately with a maximum of ten events. This lets the
      // equality filter and the canonical follows/{viewerUid_authorUid} document jointly
      // satisfy the rule without broad whereIn queries.
      function isFollowingAuthor(authorUid) {
        // The follows document is the canonical relationship source; publicFollowing is
        // only a projection used for profile UI and may lag behind older relationship data.
        let followId = request.auth.uid + '_' + authorUid;
        return signedIn()
          && exists(/databases/$(database)/documents/follows/$(followId));
      }

      function validFeedEvent() {
        return request.resource.data.keys().hasOnly([
          'authorUid', 'authorName', 'authorUsername', 'eventType',
          'occurredAtEpochMs', 'periodKey', 'exerciseType',
          'valueLong', 'valueInt', 'accuracyPercent',
          'relatedUserFirebaseUid', 'relatedUserName'
        ])
          && request.resource.data.authorUid is string
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.authorName is string
          && request.resource.data.authorName.size() <= 80
          && request.resource.data.eventType in [
            'WEEKLY_STREAK', 'WEEKLY_CHALLENGE', 'MONTHLY_STREAK',
            'PERSONAL_RECORD', 'WEEKLY_XP_MILESTONE', 'GIFT_RECEIVED'
          ]
          && request.resource.data.occurredAtEpochMs is int
          && (!request.resource.data.keys().hasAny(['authorUsername']) || request.resource.data.authorUsername is string)
          && (!request.resource.data.keys().hasAny(['periodKey']) || request.resource.data.periodKey is string)
          && (!request.resource.data.keys().hasAny(['exerciseType']) || request.resource.data.exerciseType is string)
          && (!request.resource.data.keys().hasAny(['valueLong']) || request.resource.data.valueLong is int)
          && (!request.resource.data.keys().hasAny(['valueInt']) || request.resource.data.valueInt is int)
          && (!request.resource.data.keys().hasAny(['accuracyPercent']) || request.resource.data.accuracyPercent is number)
          && (!request.resource.data.keys().hasAny(['relatedUserFirebaseUid']) || request.resource.data.relatedUserFirebaseUid is string)
          && (!request.resource.data.keys().hasAny(['relatedUserName']) || (
            request.resource.data.relatedUserName is string && request.resource.data.relatedUserName.size() <= 80
          ))
          && (request.resource.data.eventType != 'GIFT_RECEIVED' || (
            request.resource.data.periodKey in ['CANDY', 'COFFEE', 'CROISSANT', 'HAMBURGER', 'CAKE']
            && request.resource.data.relatedUserFirebaseUid is string
            && request.resource.data.relatedUserName is string
            && request.resource.data.valueInt is int
          ));
      }

      allow get: if signedIn()
        && (
          resource.data.authorUid == request.auth.uid
          || isFollowingAuthor(resource.data.authorUid)
        );

      allow list: if signedIn()
        && request.query.limit <= 10
        && (
          resource.data.authorUid == request.auth.uid
          || isFollowingAuthor(resource.data.authorUid)
        );

      allow create: if signedIn() && validFeedEvent();
      allow update: if signedIn()
        && resource.data.authorUid == request.auth.uid
        && validFeedEvent();
      allow delete: if signedIn() && resource.data.authorUid == request.auth.uid;
    }

    // Gifts are immutable deliveries. The client may retry the same gift ID, but cannot
    // alter a delivery after creation. The recipient alone can read the inbox.
    match /giftDeliveries/{recipientUid}/items/{giftId} {
      function validGiftPayload() {
        return request.resource.data.keys().hasOnly([
          'giftId', 'senderUid', 'senderName', 'recipientUid',
          'giftType', 'amount', 'createdAtEpochMs'
        ])
          && request.resource.data.giftId == giftId
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() <= 80
          && request.resource.data.recipientUid == recipientUid
          && request.resource.data.giftType in ['CANDY', 'COFFEE', 'CROISSANT', 'HAMBURGER', 'CAKE']
          && request.resource.data.amount is int
          && (
            (request.resource.data.giftType == 'CANDY' && request.resource.data.amount == 10)
            || (request.resource.data.giftType == 'COFFEE' && request.resource.data.amount == 20)
            || (request.resource.data.giftType == 'CROISSANT' && request.resource.data.amount == 30)
            || (request.resource.data.giftType == 'HAMBURGER' && request.resource.data.amount == 40)
            || (request.resource.data.giftType == 'CAKE' && request.resource.data.amount == 50)
          )
          && request.resource.data.createdAtEpochMs is int;
      }

      allow get, list: if isOwner(recipientUid);
      allow create: if signedIn()
        && request.auth.uid != recipientUid
        && validGiftPayload()
        && exists(/databases/$(database)/documents/publicProfiles/$(recipientUid))
        && exists(/databases/$(database)/documents/follows/$(request.auth.uid + '_' + recipientUid))
        && !exists(/databases/$(database)/documents/blockedUsers/$(request.auth.uid)/users/$(recipientUid))
        && !exists(/databases/$(database)/documents/blockedUsers/$(recipientUid)/users/$(request.auth.uid));
      allow update: if signedIn()
        && resource.data.senderUid == request.auth.uid
        && request.resource.data == resource.data;
      allow delete: if false;
    }
  }
}
))
          );
      }

      allow get, list: if canViewCollectibles();
      allow create, update: if isOwner(uid) && validCollectible();
      allow delete: if isOwner(uid);
    }

    match /blockedUsers/{blockerUid}/users/{blockedUid} {
      allow get: if signedIn() && (request.auth.uid == blockerUid || request.auth.uid == blockedUid);
      allow list: if signedIn() && request.auth.uid == blockerUid;
      allow create: if isOwner(blockerUid)
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == blockedUid
        && blockedUid != blockerUid;
      allow update: if false;
      allow delete: if isOwner(blockerUid);
    }
    match /usernames/{username} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && validUsername(username)
        && request.resource.data.keys().hasOnly(['userId'])
        && request.resource.data.userId == request.auth.uid
        && !exists(/databases/$(database)/documents/usernames/$(username))
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.usernameLower == username
        && getAfter(/databases/$(database)/documents/publicProfiles/$(request.auth.uid)).data.usernameLower == username;
      allow update: if false;
      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid
        && !existsAfter(/databases/$(database)/documents/users/$(request.auth.uid))
        && !existsAfter(/databases/$(database)/documents/publicProfiles/$(request.auth.uid));
    }

    match /inviteCodes/{inviteCode} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && validInviteCode(inviteCode)
        && request.resource.data.keys().hasOnly(['userId'])
        && request.resource.data.userId == request.auth.uid
        && !exists(/databases/$(database)/documents/inviteCodes/$(inviteCode))
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.inviteCode == inviteCode
        && getAfter(/databases/$(database)/documents/publicProfiles/$(request.auth.uid)).data.inviteCode == inviteCode;
      allow update: if false;
      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid
        && !existsAfter(/databases/$(database)/documents/users/$(request.auth.uid))
        && !existsAfter(/databases/$(database)/documents/publicProfiles/$(request.auth.uid));
    }

    match /follows/{followId} {
      allow get: if signedIn()
        && (
          !exists(/databases/$(database)/documents/follows/$(followId))
          || resource.data.followerUid == request.auth.uid
          || resource.data.followingUid == request.auth.uid
        );
      allow list: if signedIn()
        && (
          resource.data.followerUid == request.auth.uid
          || resource.data.followingUid == request.auth.uid
        );
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['followerUid', 'followingUid', 'createdAt'])
        && request.resource.data.followerUid == request.auth.uid
        && request.resource.data.followingUid is string
        && request.resource.data.followingUid != request.auth.uid
        && followId == request.resource.data.followerUid + '_' + request.resource.data.followingUid
        && exists(/databases/$(database)/documents/publicProfiles/$(request.resource.data.followingUid))
        && !exists(/databases/$(database)/documents/blockedUsers/$(request.auth.uid)/users/$(request.resource.data.followingUid))
        && !exists(/databases/$(database)/documents/blockedUsers/$(request.resource.data.followingUid)/users/$(request.auth.uid));
      allow update: if false;
      allow delete: if signedIn()
        && (
          resource.data.followerUid == request.auth.uid
          || (
            resource.data.followingUid == request.auth.uid
            && existsAfter(/databases/$(database)/documents/blockedUsers/$(request.auth.uid)/users/$(resource.data.followerUid))
          )
        );
    }

    // Public relationship projections let signed-in users inspect another profile's lists
    // without granting access to arbitrary documents in the internal follows collection.
    match /publicFollowing/{profileUid}/users/{followingUid} {
      allow get, list: if signedIn()
        && !exists(/databases/$(database)/documents/blockedUsers/$(profileUid)/users/$(request.auth.uid));
      allow create: if signedIn()
        && request.auth.uid == profileUid
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == followingUid
        && existsAfter(/databases/$(database)/documents/follows/$(profileUid + '_' + followingUid))
        && getAfter(/databases/$(database)/documents/follows/$(profileUid + '_' + followingUid)).data.followingUid == followingUid;
      allow update: if false;
      allow delete: if signedIn()
        && (request.auth.uid == profileUid || request.auth.uid == followingUid)
        && !existsAfter(/databases/$(database)/documents/follows/$(profileUid + '_' + followingUid));
    }

    match /publicFollowers/{profileUid}/users/{followerUid} {
      allow get, list: if signedIn()
        && !exists(/databases/$(database)/documents/blockedUsers/$(profileUid)/users/$(request.auth.uid));
      allow create: if signedIn()
        && (request.auth.uid == followerUid || request.auth.uid == profileUid)
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == followerUid
        && existsAfter(/databases/$(database)/documents/follows/$(followerUid + '_' + profileUid))
        && getAfter(/databases/$(database)/documents/follows/$(followerUid + '_' + profileUid)).data.followingUid == profileUid;
      allow update: if false;
      allow delete: if signedIn()
        && (request.auth.uid == followerUid || request.auth.uid == profileUid)
        && !existsAfter(/databases/$(database)/documents/follows/$(followerUid + '_' + profileUid));
    }
    match /feedEvents/{eventId} {
      // Each author is queried separately with a maximum of ten events. This lets the
      // equality filter and the canonical follows/{viewerUid_authorUid} document jointly
      // satisfy the rule without broad whereIn queries.
      function isFollowingAuthor(authorUid) {
        // The follows document is the canonical relationship source; publicFollowing is
        // only a projection used for profile UI and may lag behind older relationship data.
        let followId = request.auth.uid + '_' + authorUid;
        return signedIn()
          && exists(/databases/$(database)/documents/follows/$(followId));
      }

      function validFeedEvent() {
        return request.resource.data.keys().hasOnly([
          'authorUid', 'authorName', 'authorUsername', 'eventType',
          'occurredAtEpochMs', 'periodKey', 'exerciseType',
          'valueLong', 'valueInt', 'accuracyPercent',
          'relatedUserFirebaseUid', 'relatedUserName'
        ])
          && request.resource.data.authorUid is string
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.authorName is string
          && request.resource.data.authorName.size() <= 80
          && request.resource.data.eventType in [
            'WEEKLY_STREAK', 'WEEKLY_CHALLENGE', 'MONTHLY_STREAK',
            'PERSONAL_RECORD', 'WEEKLY_XP_MILESTONE', 'GIFT_RECEIVED'
          ]
          && request.resource.data.occurredAtEpochMs is int
          && (!request.resource.data.keys().hasAny(['authorUsername']) || request.resource.data.authorUsername is string)
          && (!request.resource.data.keys().hasAny(['periodKey']) || request.resource.data.periodKey is string)
          && (!request.resource.data.keys().hasAny(['exerciseType']) || request.resource.data.exerciseType is string)
          && (!request.resource.data.keys().hasAny(['valueLong']) || request.resource.data.valueLong is int)
          && (!request.resource.data.keys().hasAny(['valueInt']) || request.resource.data.valueInt is int)
          && (!request.resource.data.keys().hasAny(['accuracyPercent']) || request.resource.data.accuracyPercent is number)
          && (!request.resource.data.keys().hasAny(['relatedUserFirebaseUid']) || request.resource.data.relatedUserFirebaseUid is string)
          && (!request.resource.data.keys().hasAny(['relatedUserName']) || (
            request.resource.data.relatedUserName is string && request.resource.data.relatedUserName.size() <= 80
          ))
          && (request.resource.data.eventType != 'GIFT_RECEIVED' || (
            request.resource.data.periodKey in ['CANDY', 'COFFEE', 'CROISSANT', 'HAMBURGER', 'CAKE']
            && request.resource.data.relatedUserFirebaseUid is string
            && request.resource.data.relatedUserName is string
            && request.resource.data.valueInt is int
          ));
      }

      allow get: if signedIn()
        && (
          resource.data.authorUid == request.auth.uid
          || isFollowingAuthor(resource.data.authorUid)
        );

      allow list: if signedIn()
        && request.query.limit <= 10
        && (
          resource.data.authorUid == request.auth.uid
          || isFollowingAuthor(resource.data.authorUid)
        );

      allow create: if signedIn() && validFeedEvent();
      allow update: if signedIn()
        && resource.data.authorUid == request.auth.uid
        && validFeedEvent();
      allow delete: if signedIn() && resource.data.authorUid == request.auth.uid;
    }

    // Gifts are immutable deliveries. The client may retry the same gift ID, but cannot
    // alter a delivery after creation. The recipient alone can read the inbox.
    match /giftDeliveries/{recipientUid}/items/{giftId} {
      function validGiftPayload() {
        return request.resource.data.keys().hasOnly([
          'giftId', 'senderUid', 'senderName', 'recipientUid',
          'giftType', 'amount', 'createdAtEpochMs'
        ])
          && request.resource.data.giftId == giftId
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() <= 80
          && request.resource.data.recipientUid == recipientUid
          && request.resource.data.giftType in ['CANDY', 'COFFEE', 'CROISSANT', 'HAMBURGER', 'CAKE']
          && request.resource.data.amount is int
          && (
            (request.resource.data.giftType == 'CANDY' && request.resource.data.amount == 10)
            || (request.resource.data.giftType == 'COFFEE' && request.resource.data.amount == 20)
            || (request.resource.data.giftType == 'CROISSANT' && request.resource.data.amount == 30)
            || (request.resource.data.giftType == 'HAMBURGER' && request.resource.data.amount == 40)
            || (request.resource.data.giftType == 'CAKE' && request.resource.data.amount == 50)
          )
          && request.resource.data.createdAtEpochMs is int;
      }

      allow get, list: if isOwner(recipientUid);
      allow create: if signedIn()
        && request.auth.uid != recipientUid
        && validGiftPayload()
        && exists(/databases/$(database)/documents/publicProfiles/$(recipientUid))
        && exists(/databases/$(database)/documents/follows/$(request.auth.uid + '_' + recipientUid))
        && !exists(/databases/$(database)/documents/blockedUsers/$(request.auth.uid)/users/$(recipientUid))
        && !exists(/databases/$(database)/documents/blockedUsers/$(recipientUid)/users/$(request.auth.uid));
      allow update: if signedIn()
        && resource.data.senderUid == request.auth.uid
        && request.resource.data == resource.data;
      allow delete: if false;
    }
  }
}
