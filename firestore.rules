rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function activeUser() {
      return signedIn()
        && !exists(/databases/$(database)/documents/deletedProfiles/$(request.auth.uid));
    }

    function canAccessOwnData(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function canDeleteOwnData(uid) {
      // A deleted UID may finish erasing data it owns, but activeUser() blocks new writes.
      return signedIn() && request.auth.uid == uid;
    }

    function isOwner(uid) {
      return activeUser() && request.auth.uid == uid;
    }

    match /deletedProfiles/{uid} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['uid', 'deletedAt', 'cleanupComplete'])
        && request.resource.data.uid == uid
        && request.resource.data.deletedAt is timestamp
        && request.resource.data.cleanupComplete == false;
      allow update: if canAccessOwnData(uid)
        && resource.data.uid == uid
        && resource.data.get('cleanupComplete', false) == false
        && request.resource.data.keys().hasOnly(['uid', 'deletedAt', 'cleanupComplete', 'cleanedAt'])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.deletedAt == resource.data.deletedAt
        && request.resource.data.cleanupComplete == true
        && request.resource.data.cleanedAt is timestamp;
      allow delete: if false;
    }

    function validUsername(value) {
      return value is string && value.matches('^[a-z0-9_]{3,20}$');
    }

    function validUsernameFields() {
      return request.resource.data.username is string
        && (request.resource.data.username == '' || validUsername(request.resource.data.username))
        && request.resource.data.usernameLower == request.resource.data.username.lower();
    }

    function validInviteCode(value) {
      return value is string && value.matches('^[A-HJ-NP-Z2-9]{8}$');
    }

    function ownsUsernameReservation(uid) {
      return request.resource.data.username == ''
        || getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.userId == uid;
    }

    function ownsInviteCodeReservation(uid) {
      return validInviteCode(request.resource.data.inviteCode)
        && getAfter(/databases/$(database)/documents/inviteCodes/$(request.resource.data.inviteCode)).data.userId == uid;
    }

    function validPublicProfileFields() {
      return (!request.resource.data.keys().hasAny(['displayName']) || request.resource.data.displayName is string)
        && (!request.resource.data.keys().hasAny(['profileInfoVisible']) || request.resource.data.profileInfoVisible is bool)
        && (!request.resource.data.keys().hasAny(['avatarConfigurationJson']) || request.resource.data.avatarConfigurationJson is string)
        && (!request.resource.data.keys().hasAny(['country']) || request.resource.data.country is string)
        && (!request.resource.data.keys().hasAny(['city']) || request.resource.data.city is string)
        && (!request.resource.data.keys().hasAny(['gender']) || request.resource.data.gender in ['', 'MALE', 'FEMALE'])
        && (!request.resource.data.keys().hasAny(['memberSinceEpochMs']) || request.resource.data.memberSinceEpochMs is int)
        && (!request.resource.data.keys().hasAny(['statistics']) || (
          request.resource.data.statistics is map
          && request.resource.data.statistics.keys().hasOnly([
            'currentStreakDays', 'bestStreakDays', 'totalExerciseCount',
            'lastSevenDaysExerciseCount', 'totalDurationMs', 'firstTrainingDate',
            'bestExerciseStats'
          ])
        ));
    }

    match /users/{uid} {
      allow get: if canAccessOwnData(uid);
      allow list: if false;
      allow create, update: if isOwner(uid)
        && request.resource.data.uid == uid
        && validUsernameFields()
        && ownsUsernameReservation(uid)
        && ownsInviteCodeReservation(uid)
        && getAfter(/databases/$(database)/documents/publicProfiles/$(uid)).data.usernameLower
          == request.resource.data.usernameLower
        && getAfter(/databases/$(database)/documents/publicProfiles/$(uid)).data.inviteCode
          == request.resource.data.inviteCode;
      allow delete: if canDeleteOwnData(uid)
        && !existsAfter(/databases/$(database)/documents/publicProfiles/$(uid))
        && (
          resource.data.get('usernameLower', '') == ''
          || !existsAfter(/databases/$(database)/documents/usernames/$(resource.data.get('usernameLower', '')))
        )
        && (
          !resource.data.keys().hasAny(['inviteCode'])
          || !existsAfter(/databases/$(database)/documents/inviteCodes/$(resource.data.get('inviteCode', '')))
        );
    }

    match /publicProfiles/{uid} {
      allow get: if canAccessOwnData(uid) || (signedIn()
        && resource.data.get('profileInfoVisible', true) == true
        && !exists(/databases/$(database)/documents/blockedUsers/$(uid)/users/$(request.auth.uid)));
      allow list: if false;
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'avatarUrl', 'avatarConfigurationJson', 'country', 'city',
          'gender', 'memberSinceEpochMs', 'statistics', 'username', 'usernameLower', 'inviteCode', 'updatedAt', 'profileInfoVisible'
        ])
        && validPublicProfileFields()
        && request.resource.data.uid == uid
        && validUsernameFields()
        && ownsUsernameReservation(uid)
        && ownsInviteCodeReservation(uid)
        && getAfter(/databases/$(database)/documents/users/$(uid)).data.usernameLower
          == request.resource.data.usernameLower
        && getAfter(/databases/$(database)/documents/users/$(uid)).data.inviteCode
          == request.resource.data.inviteCode;
      allow delete: if canDeleteOwnData(uid)
        && !existsAfter(/databases/$(database)/documents/users/$(uid))
        && (
          resource.data.get('usernameLower', '') == ''
          || !existsAfter(/databases/$(database)/documents/usernames/$(resource.data.get('usernameLower', '')))
        )
        && (
          !resource.data.keys().hasAny(['inviteCode'])
          || !existsAfter(/databases/$(database)/documents/inviteCodes/$(resource.data.get('inviteCode', '')))
        );
    }

    match /publicProfileCards/{uid} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'username', 'usernameLower', 'avatarConfigurationJson', 'updatedAt', 'profileInfoVisible'])
        && request.resource.data.uid == uid
        && request.resource.data.displayName is string
        && request.resource.data.username is string
        && request.resource.data.usernameLower == request.resource.data.username.lower()
        && request.resource.data.avatarConfigurationJson is string
        && (!request.resource.data.keys().hasAny(['profileInfoVisible']) || request.resource.data.profileInfoVisible is bool)
        && existsAfter(/databases/$(database)/documents/users/$(uid))
        && existsAfter(/databases/$(database)/documents/publicProfiles/$(uid));
      allow delete: if canDeleteOwnData(uid)
        && !existsAfter(/databases/$(database)/documents/users/$(uid))
        && !existsAfter(/databases/$(database)/documents/publicProfiles/$(uid));
    }

    // Public-safe gift and badge metadata for profile collection previews and details.
    match /publicProfileCards/{uid}/collectibles/{collectibleId} {
      function canViewCollectibles() {
        return signedIn()
          && exists(/databases/$(database)/documents/publicProfiles/$(uid))
          && get(/databases/$(database)/documents/publicProfiles/$(uid)).data.get('profileInfoVisible', true) == true
          && !exists(/databases/$(database)/documents/blockedUsers/$(uid)/users/$(request.auth.uid))
          && !exists(/databases/$(database)/documents/blockedUsers/$(request.auth.uid)/users/$(uid));
      }

      function validCollectible() {
        return request.resource.data.keys().hasOnly([
          'id', 'kind', 'itemType', 'acquiredAtEpochMs', 'senderFirebaseUid',
          'senderName', 'periodKey', 'triggerWorkoutId', 'amount'
        ])
          && request.resource.data.keys().hasAll(['id', 'kind', 'itemType', 'acquiredAtEpochMs'])
          && request.resource.data.id is string
          && request.resource.data.kind in ['GIFT', 'BADGE']
          && request.resource.data.itemType is string
          && request.resource.data.acquiredAtEpochMs is int
          && collectibleId == (request.resource.data.kind == 'GIFT' ? 'gift_' : 'badge_') + request.resource.data.id
          && (!request.resource.data.keys().hasAny(['senderFirebaseUid']) || request.resource.data.senderFirebaseUid is string)
          && (!request.resource.data.keys().hasAny(['senderName']) || (
            request.resource.data.senderName is string && request.resource.data.senderName.size() <= 80
          ))
          && (!request.resource.data.keys().hasAny(['periodKey']) || request.resource.data.periodKey is string)
          && (!request.resource.data.keys().hasAny(['triggerWorkoutId']) || request.resource.data.triggerWorkoutId is int)
          && (!request.resource.data.keys().hasAny(['amount']) || request.resource.data.amount is int)
          && (
            (
              request.resource.data.kind == 'GIFT'
              && request.resource.data.itemType in ['CANDY', 'COFFEE', 'CROISSANT', 'HAMBURGER', 'CAKE']
            )
            || (
              request.resource.data.kind == 'BADGE'
              && request.resource.data.itemType in [
                'WEEKLY_STREAK', 'WEEKLY_CHALLENGE',
                'MONTHLY_CHALLENGE_01', 'MONTHLY_CHALLENGE_02',
                'MONTHLY_CHALLENGE_03', 'MONTHLY_CHALLENGE_04',
                'MONTHLY_CHALLENGE_05', 'MONTHLY_CHALLENGE_06',
                'MONTHLY_CHALLENGE_07', 'MONTHLY_CHALLENGE_08',
                'MONTHLY_CHALLENGE_09', 'MONTHLY_CHALLENGE_10',
                'MONTHLY_CHALLENGE_11', 'MONTHLY_CHALLENGE_12',
                'MONTH_01', 'MONTH_02', 'MONTH_03', 'MONTH_04',
                'MONTH_05', 'MONTH_06', 'MONTH_07', 'MONTH_08',
                'MONTH_09', 'MONTH_10', 'MONTH_11', 'MONTH_12'
              ]
            )
          );
      }

      allow get, list: if isOwner(uid) || canViewCollectibles();
      allow create, update: if isOwner(uid) && validCollectible()
        && exists(/databases/$(database)/documents/publicProfiles/$(uid));
      allow delete: if canDeleteOwnData(uid);
    }

    match /blockedUsers/{blockerUid}/users/{blockedUid} {
      allow get: if signedIn() && (request.auth.uid == blockerUid || request.auth.uid == blockedUid);
      allow list: if signedIn() && request.auth.uid == blockerUid;
      allow create: if isOwner(blockerUid)
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == blockedUid
        && blockedUid != blockerUid;
      allow update: if false;
      allow delete: if canDeleteOwnData(blockerUid);
    }
    match /usernames/{username} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if activeUser()
        && validUsername(username)
        && request.resource.data.keys().hasOnly(['userId'])
        && request.resource.data.userId == request.auth.uid
        && !exists(/databases/$(database)/documents/usernames/$(username))
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.usernameLower == username
        && getAfter(/databases/$(database)/documents/publicProfiles/$(request.auth.uid)).data.usernameLower == username;
      allow update: if false;
      allow delete: if canDeleteOwnData(request.auth.uid)
        && resource.data.userId == request.auth.uid
        && !existsAfter(/databases/$(database)/documents/users/$(request.auth.uid))
        && !existsAfter(/databases/$(database)/documents/publicProfiles/$(request.auth.uid));
    }

    match /inviteCodes/{inviteCode} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if activeUser()
        && validInviteCode(inviteCode)
        && request.resource.data.keys().hasOnly(['userId'])
        && request.resource.data.userId == request.auth.uid
        && !exists(/databases/$(database)/documents/inviteCodes/$(inviteCode))
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.inviteCode == inviteCode
        && getAfter(/databases/$(database)/documents/publicProfiles/$(request.auth.uid)).data.inviteCode == inviteCode;
      allow update: if false;
      allow delete: if canDeleteOwnData(request.auth.uid)
        && resource.data.userId == request.auth.uid
        && !existsAfter(/databases/$(database)/documents/users/$(request.auth.uid))
        && !existsAfter(/databases/$(database)/documents/publicProfiles/$(request.auth.uid));
    }

    match /follows/{followId} {
      allow get: if signedIn()
        && (
          !exists(/databases/$(database)/documents/follows/$(followId))
          || resource.data.followerUid == request.auth.uid
          || resource.data.followingUid == request.auth.uid
        );
      allow list: if signedIn()
        && (
          resource.data.followerUid == request.auth.uid
          || resource.data.followingUid == request.auth.uid
        );
      allow create: if activeUser()
        && request.resource.data.keys().hasOnly(['followerUid', 'followingUid', 'createdAt'])
        && request.resource.data.followerUid == request.auth.uid
        && request.resource.data.followingUid is string
        && request.resource.data.followingUid != request.auth.uid
        && followId == request.resource.data.followerUid + '_' + request.resource.data.followingUid
        && exists(/databases/$(database)/documents/publicProfiles/$(request.resource.data.followingUid))
        && !exists(/databases/$(database)/documents/deletedProfiles/$(request.resource.data.followingUid))
        && !exists(/databases/$(database)/documents/blockedUsers/$(request.auth.uid)/users/$(request.resource.data.followingUid))
        && !exists(/databases/$(database)/documents/blockedUsers/$(request.resource.data.followingUid)/users/$(request.auth.uid));
      allow update: if false;
      allow delete: if signedIn()
        && (
          resource.data.followerUid == request.auth.uid
          || resource.data.followingUid == request.auth.uid
        );
    }

    // Public relationship projections let signed-in users inspect another profile's lists
    // without granting access to arbitrary documents in the internal follows collection.
    match /publicFollowing/{profileUid}/users/{followingUid} {
      function profileAllowsConnectionList() {
        return get(/databases/$(database)/documents/publicProfiles/$(profileUid)).data.get('profileInfoVisible', true) == true;
      }
      allow get: if signedIn()
        && (request.auth.uid == profileUid || (profileAllowsConnectionList()
          && (request.auth.uid == followingUid
            || !exists(/databases/$(database)/documents/blockedUsers/$(profileUid)/users/$(request.auth.uid)))));
      allow list: if signedIn()
        && (request.auth.uid == profileUid || (profileAllowsConnectionList()
          && !exists(/databases/$(database)/documents/blockedUsers/$(profileUid)/users/$(request.auth.uid))));
      allow create: if activeUser()
        && request.auth.uid == profileUid
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == followingUid
        && existsAfter(/databases/$(database)/documents/follows/$(profileUid + '_' + followingUid))
        && getAfter(/databases/$(database)/documents/follows/$(profileUid + '_' + followingUid)).data.followingUid == followingUid;
      allow update: if false;
      allow delete: if signedIn()
        && (request.auth.uid == profileUid || request.auth.uid == followingUid)
        && !existsAfter(/databases/$(database)/documents/follows/$(profileUid + '_' + followingUid));
    }

    match /publicFollowers/{profileUid}/users/{followerUid} {
      function profileAllowsConnectionList() {
        return get(/databases/$(database)/documents/publicProfiles/$(profileUid)).data.get('profileInfoVisible', true) == true;
      }
      allow get: if signedIn()
        && (request.auth.uid == profileUid || (profileAllowsConnectionList()
          && (request.auth.uid == followerUid
            || !exists(/databases/$(database)/documents/blockedUsers/$(profileUid)/users/$(request.auth.uid)))));
      allow list: if signedIn()
        && (request.auth.uid == profileUid || (profileAllowsConnectionList()
          && !exists(/databases/$(database)/documents/blockedUsers/$(profileUid)/users/$(request.auth.uid))));
      allow create: if activeUser()
        && (request.auth.uid == followerUid || request.auth.uid == profileUid)
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == followerUid
        && existsAfter(/databases/$(database)/documents/follows/$(followerUid + '_' + profileUid))
        && getAfter(/databases/$(database)/documents/follows/$(followerUid + '_' + profileUid)).data.followingUid == profileUid;
      allow update: if false;
      allow delete: if signedIn()
        && (request.auth.uid == followerUid || request.auth.uid == profileUid)
        && !existsAfter(/databases/$(database)/documents/follows/$(followerUid + '_' + profileUid));
    }
    match /feedEvents/{eventId} {
      function authorAllowsFeedUpdates(authorUid) {
        return get(/databases/$(database)/documents/users/$(authorUid)).data.get('feedUpdatesEnabled', true) == true;
      }
      // Each author is queried separately with a maximum of ten events. This lets the
      // equality filter and the canonical follows/{viewerUid_authorUid} document jointly
      // satisfy the rule without broad whereIn queries.
      function isFollowingAuthor(authorUid) {
        // The follows document is the canonical relationship source; publicFollowing is
        // only a projection used for profile UI and may lag behind older relationship data.
        let followId = request.auth.uid + '_' + authorUid;
        return signedIn()
          && exists(/databases/$(database)/documents/follows/$(followId));
      }

      function validFeedEvent() {
        return request.resource.data.keys().hasOnly([
          'authorUid', 'authorName', 'authorUsername', 'eventType',
          'occurredAtEpochMs', 'periodKey', 'exerciseType',
          'valueLong', 'valueInt', 'accuracyPercent',
          'relatedUserFirebaseUid', 'relatedUserName'
        ])
          && request.resource.data.authorUid is string
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.authorName is string
          && request.resource.data.authorName.size() <= 80
          && request.resource.data.eventType in [
            'WEEKLY_STREAK', 'WEEKLY_CHALLENGE', 'MONTHLY_STREAK',
            'MONTHLY_CHALLENGE', 'PERSONAL_RECORD', 'WEEKLY_XP_MILESTONE',
            'GIFT_RECEIVED', 'GIFT_SENT',
            'COSMETIC_GIFT_SENT', 'COSMETIC_GIFT_RECEIVED',
            'COSMETIC_PURCHASED', 'FOLLOWED_USER'
          ]
          && request.resource.data.occurredAtEpochMs is int
          && (!request.resource.data.keys().hasAny(['authorUsername']) || request.resource.data.authorUsername is string)
          && (!request.resource.data.keys().hasAny(['periodKey']) || request.resource.data.periodKey is string)
          && (!request.resource.data.keys().hasAny(['exerciseType']) || request.resource.data.exerciseType is string)
          && (!request.resource.data.keys().hasAny(['valueLong']) || request.resource.data.valueLong is int)
          && (!request.resource.data.keys().hasAny(['valueInt']) || request.resource.data.valueInt is int)
          && (!request.resource.data.keys().hasAny(['accuracyPercent']) || request.resource.data.accuracyPercent is number)
          && (!request.resource.data.keys().hasAny(['relatedUserFirebaseUid']) || request.resource.data.relatedUserFirebaseUid is string)
          && (!request.resource.data.keys().hasAny(['relatedUserName']) || (
            request.resource.data.relatedUserName is string && request.resource.data.relatedUserName.size() <= 80
          ))
          && (request.resource.data.eventType != 'GIFT_RECEIVED' || (
            request.resource.data.periodKey in ['CANDY', 'COFFEE', 'CROISSANT', 'HAMBURGER', 'CAKE']
            && request.resource.data.relatedUserFirebaseUid is string
            && request.resource.data.relatedUserName is string
            && request.resource.data.valueInt is int
          ))
          && (request.resource.data.eventType != 'GIFT_SENT' || (
            request.resource.data.periodKey in ['CANDY', 'COFFEE', 'CROISSANT', 'HAMBURGER', 'CAKE']
            && request.resource.data.relatedUserFirebaseUid is string
            && request.resource.data.valueInt is int
          ))
          && (request.resource.data.eventType != 'COSMETIC_GIFT_SENT'
            && request.resource.data.eventType != 'COSMETIC_GIFT_RECEIVED' || (
              request.resource.data.periodKey is string
              && request.resource.data.exerciseType in ['COSTUME', 'BACKGROUND']
              && request.resource.data.relatedUserFirebaseUid is string
              && request.resource.data.valueInt == 100
            ))
          && (request.resource.data.eventType != 'COSMETIC_GIFT_RECEIVED'
            || request.resource.data.relatedUserName is string)
          && (request.resource.data.eventType != 'FOLLOWED_USER'
            || request.resource.data.relatedUserFirebaseUid is string)
          && (request.resource.data.eventType != 'COSMETIC_PURCHASED' || (
            request.resource.data.periodKey is string
            && request.resource.data.exerciseType in ['COSTUME', 'BACKGROUND']
            && request.resource.data.valueInt is int
          ));
      }

      allow get: if signedIn()
        && (
          resource.data.authorUid == request.auth.uid
          || (isFollowingAuthor(resource.data.authorUid) && authorAllowsFeedUpdates(resource.data.authorUid))
        );

      allow list: if signedIn()
        && request.query.limit <= 10
        && (
          resource.data.authorUid == request.auth.uid
          || (isFollowingAuthor(resource.data.authorUid) && authorAllowsFeedUpdates(resource.data.authorUid))
        );

      allow create: if activeUser() && validFeedEvent() && authorAllowsFeedUpdates(request.auth.uid);
      allow update: if activeUser()
        && resource.data.authorUid == request.auth.uid
        && validFeedEvent()
        && authorAllowsFeedUpdates(request.auth.uid);
      allow delete: if signedIn() && resource.data.authorUid == request.auth.uid;
    }


    // Multiplayer rock-paper-scissors rooms.
    match /gameRooms/{roomId} {
      function roomPath() {
        return /databases/$(database)/documents/gameRooms/$(roomId);
      }

      function currentRoomMember() {
        return signedIn()
          && exists(/databases/$(database)/documents/gameRooms/$(roomId)/members/$(request.auth.uid));
      }

      function memberUid(uid) {
        return exists(/databases/$(database)/documents/gameRooms/$(roomId)/members/$(uid));
      }

      function validRoomJoinUpdate() {
        let before = resource.data.get('memberUids', []);
        let after = request.resource.data.get('memberUids', []);
        let memberPath = /databases/$(database)/documents/gameRooms/$(roomId)/members/$(request.auth.uid);
        let memberAfter = getAfter(memberPath).data;
        return !(request.auth.uid in before)
          && request.auth.uid in after
          && after.size() == before.size() + 1
          && after.hasAll(before)
          && existsAfter(memberPath)
          && memberAfter.uid == request.auth.uid
          && (
            resource.data.isPublic == true
            || memberAfter.get('joinedAsOwner', false) == true
            || (
              memberAfter.get('joinedViaCode', '') is string
              && memberAfter.get('joinedViaCode', '') == resource.data.get('inviteCode', '')
              && exists(/databases/$(database)/documents/gameRoomCodes/$(memberAfter.joinedViaCode))
              && get(/databases/$(database)/documents/gameRoomCodes/$(memberAfter.joinedViaCode)).data.roomId == roomId
            )
            || (
              memberAfter.get('joinedViaInvitationId', '') is string
              && existsAfter(/databases/$(database)/documents/gameRoomInvitations/$(request.auth.uid)/items/$(memberAfter.joinedViaInvitationId))
              && getAfter(/databases/$(database)/documents/gameRoomInvitations/$(request.auth.uid)/items/$(memberAfter.joinedViaInvitationId)).data.status == 'ACCEPTED'
              && getAfter(/databases/$(database)/documents/gameRoomInvitations/$(request.auth.uid)/items/$(memberAfter.joinedViaInvitationId)).data.roomId == roomId
            )
          );
      }

      function validRoomLeaveUpdate() {
        let before = resource.data.get('memberUids', []);
        let after = request.resource.data.get('memberUids', []);
        return request.auth.uid in before
          && !(request.auth.uid in after)
          && after.size() == before.size() - 1
          && before.hasAll(after)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'memberUids', 'ownerUid', 'updatedAtEpochMs'
          ])
          && request.resource.data.updatedAtEpochMs is int
          && !existsAfter(/databases/$(database)/documents/gameRooms/$(roomId)/members/$(request.auth.uid))
          && (request.resource.data.ownerUid == resource.data.ownerUid
            || request.resource.data.ownerUid in after);
      }

      function validRoomSettingsUpdate() {
        return request.auth.uid == resource.data.ownerUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'isPublic', 'inviteCode', 'maxParticipants', 'targetScore', 'updatedAtEpochMs'
          ])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 40
          && request.resource.data.isPublic is bool
          && request.resource.data.maxParticipants is int
          && request.resource.data.maxParticipants >= 2
          && request.resource.data.maxParticipants <= 8
          && request.resource.data.maxParticipants >= resource.data.memberUids.size()
          && request.resource.data.targetScore is int
          && request.resource.data.targetScore >= 5
          && request.resource.data.targetScore <= 500
          && (
            (request.resource.data.isPublic == true && request.resource.data.inviteCode == null)
            || (
              request.resource.data.isPublic == false
              && validInviteCode(request.resource.data.inviteCode)
              && existsAfter(/databases/$(database)/documents/gameRoomCodes/$(request.resource.data.inviteCode))
              && getAfter(/databases/$(database)/documents/gameRoomCodes/$(request.resource.data.inviteCode)).data.roomId == roomId
            )
          );
      }

      function validRoundAdvance() {
        let previousRoundId = resource.data.currentRoundId;
        let nextRoundId = request.resource.data.currentRoundId;
        return request.auth.uid in resource.data.memberUids
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'currentRoundId', 'roundNumber', 'lastFinishedRoundId',
            'lastWinnerUid', 'lastWinnerName', 'lastWinnerScore',
            'lastRoundFinishedAtEpochMs', 'updatedAtEpochMs'
          ])
          && nextRoundId is string
          && nextRoundId != previousRoundId
          && request.resource.data.lastFinishedRoundId == previousRoundId
          && existsAfter(resultPath)
          && result.winnerUid == request.resource.data.lastWinnerUid
          && result.winnerName == request.resource.data.lastWinnerName
          && result.winningScore == request.resource.data.lastWinnerScore
          && result.finishedAtEpochMs == request.resource.data.lastRoundFinishedAtEpochMs
          && existsAfter(/databases/$(database)/documents/gameRooms/$(roomId)/rounds/$(nextRoundId))
          && getAfter(/databases/$(database)/documents/gameRooms/$(roomId)/rounds/$(nextRoundId)).data.status == 'ACTIVE'
          && getAfter(/databases/$(database)/documents/gameRooms/$(roomId)/rounds/$(nextRoundId)).data.targetScore == request.resource.data.targetScore;
      }

      allow get: if activeUser()
        && (
          resource.data.get('isPublic', false) == true
          || request.auth.uid in resource.data.get('memberUids', [])
          || (
            resource.data.get('inviteCode', '') is string
            && resource.data.get('inviteCode', '') != ''
            && exists(/databases/$(database)/documents/gameRoomCodes/$(resource.data.inviteCode))
          )
        );

      allow list: if activeUser()
        && (
          resource.data.get('isPublic', false) == true
          || request.auth.uid in resource.data.get('memberUids', [])
        );

      allow create: if activeUser()
        && request.resource.data.keys().hasOnly([
          'name', 'ownerUid', 'ownerName', 'isPublic', 'inviteCode',
          'maxParticipants', 'targetScore', 'memberUids', 'status',
          'currentRoundId', 'roundNumber', 'createdAtEpochMs', 'updatedAtEpochMs'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerName is string
        && request.resource.data.ownerName.size() <= 80
        && request.resource.data.isPublic is bool
        && request.resource.data.maxParticipants is int
        && request.resource.data.maxParticipants >= 2
        && request.resource.data.maxParticipants <= 8
        && request.resource.data.targetScore is int
        && request.resource.data.targetScore >= 5
        && request.resource.data.targetScore <= 500
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.status == 'OPEN'
        && request.resource.data.currentRoundId == '1'
        && request.resource.data.roundNumber == 1
        && request.resource.data.createdAtEpochMs is int
        && request.resource.data.updatedAtEpochMs is int
        && (
          (request.resource.data.isPublic == true && request.resource.data.inviteCode == null)
          || (
            request.resource.data.isPublic == false
            && validInviteCode(request.resource.data.inviteCode)
            && existsAfter(/databases/$(database)/documents/gameRoomCodes/$(request.resource.data.inviteCode))
            && getAfter(/databases/$(database)/documents/gameRoomCodes/$(request.resource.data.inviteCode)).data.roomId == roomId
          )
        )
        && existsAfter(/databases/$(database)/documents/gameRooms/$(roomId)/members/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/gameRooms/$(roomId)/members/$(request.auth.uid)).data.joinedAsOwner == true
        && existsAfter(/databases/$(database)/documents/gameRooms/$(roomId)/rounds/1);

      allow update: if activeUser()
        && (
          validRoomSettingsUpdate()
          || validRoomJoinUpdate()
          || validRoomLeaveUpdate()
          || validRoundAdvance()
          || (
            currentRoomMember()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAtEpochMs'])
            && request.resource.data.updatedAtEpochMs is int
          )
        );

      allow delete: if canDeleteOwnData(request.auth.uid)
        && resource.data.ownerUid == request.auth.uid
        && resource.data.memberUids.size() == 1
        && !existsAfter(/databases/$(database)/documents/gameRooms/$(roomId)/members/$(request.auth.uid));

      match /members/{uid} {
        function memberRoom() {
          return get(/databases/$(database)/documents/gameRooms/$(roomId)).data;
        }

        function validOwnReadMarkerUpdate() {
          return request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'lastReadMessageAtEpochMs', 'lastSeenFinishedRoundId'
            ])
            && (
              !request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastReadMessageAtEpochMs'])
              || request.resource.data.lastReadMessageAtEpochMs is int
            )
            && (
              !request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastSeenFinishedRoundId'])
              || request.resource.data.lastSeenFinishedRoundId is string
            );
        }

        function validRoundResetUpdate() {
          let roomBefore = get(/databases/$(database)/documents/gameRooms/$(roomId)).data;
          let roomAfter = getAfter(/databases/$(database)/documents/gameRooms/$(roomId)).data;
          return request.auth.uid in roomBefore.memberUids
            && roomAfter.currentRoundId != roomBefore.currentRoundId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'score', 'roundWins', 'roundDraws', 'roundLosses',
              'roundRockCount', 'roundPaperCount', 'roundScissorsCount', 'roundMatchesPlayed'
            ])
            && request.resource.data.score == 0
            && request.resource.data.roundWins == 0
            && request.resource.data.roundDraws == 0
            && request.resource.data.roundLosses == 0
            && request.resource.data.roundRockCount == 0
            && request.resource.data.roundPaperCount == 0
            && request.resource.data.roundScissorsCount == 0
            && request.resource.data.roundMatchesPlayed == 0;
        }

        function beats(ownMove, otherMove) {
          return (ownMove == 'ROCK' && otherMove == 'SCISSORS')
            || (ownMove == 'SCISSORS' && otherMove == 'PAPER')
            || (ownMove == 'PAPER' && otherMove == 'ROCK');
        }

        function outcome(ownMove, otherMove) {
          return ownMove == otherMove ? 'DRAW' : (beats(ownMove, otherMove) ? 'WIN' : 'LOSS');
        }

        function pointsFor(ownMove, otherMove) {
          return ownMove == otherMove ? 2 : (beats(ownMove, otherMove) ? 3 : 1);
        }

        function validResultStatsUpdate() {
          let roundId = request.resource.data.lastResultRoundId;
          let matchId = request.resource.data.lastResultMatchId;
          let matchPath = /databases/$(database)/documents/gameRooms/$(roomId)/rounds/$(roundId)/matches/$(matchId);
          let matchData = getAfter(matchPath).data;
          let isA = matchData.uidA == uid;
          let ownMove = isA ? matchData.moveA : matchData.moveB;
          let otherMove = isA ? matchData.moveB : matchData.moveA;
          let result = outcome(ownMove, otherMove);
          let finished = matchData.roundFinished == true;
          let points = pointsFor(ownMove, otherMove);
          return request.auth.uid in [matchData.uidA, matchData.uidB]
            && (isA || matchData.uidB == uid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'score', 'wins', 'draws', 'losses', 'rockCount', 'paperCount', 'scissorsCount',
              'matchesPlayed', 'roundWins', 'roundDraws', 'roundLosses',
              'roundRockCount', 'roundPaperCount', 'roundScissorsCount',
              'roundMatchesPlayed', 'lastPlayedAtEpochMs', 'lastResultMatchId', 'lastResultRoundId'
            ])
            && roundId is string
            && matchId is string
            && existsAfter(matchPath)
            && matchData.status == 'RESOLVED'
            && matchData.roundId == roundId
            && matchData.pointsA == pointsFor(matchData.moveA, matchData.moveB)
            && matchData.pointsB == pointsFor(matchData.moveB, matchData.moveA)
            && request.resource.data.lastResultMatchId == matchId
            && request.resource.data.lastResultRoundId == roundId
            && request.resource.data.score == (finished ? 0 : resource.data.score + points)
            && request.resource.data.wins == resource.data.wins + (result == 'WIN' ? 1 : 0)
            && request.resource.data.draws == resource.data.draws + (result == 'DRAW' ? 1 : 0)
            && request.resource.data.losses == resource.data.losses + (result == 'LOSS' ? 1 : 0)
            && request.resource.data.matchesPlayed == resource.data.matchesPlayed + 1
            && request.resource.data.rockCount == resource.data.rockCount + (ownMove == 'ROCK' ? 1 : 0)
            && request.resource.data.paperCount == resource.data.paperCount + (ownMove == 'PAPER' ? 1 : 0)
            && request.resource.data.scissorsCount == resource.data.scissorsCount + (ownMove == 'SCISSORS' ? 1 : 0)
            && request.resource.data.roundWins == (finished ? 0 : resource.data.roundWins + (result == 'WIN' ? 1 : 0))
            && request.resource.data.roundDraws == (finished ? 0 : resource.data.roundDraws + (result == 'DRAW' ? 1 : 0))
            && request.resource.data.roundLosses == (finished ? 0 : resource.data.roundLosses + (result == 'LOSS' ? 1 : 0))
            && request.resource.data.roundMatchesPlayed == (finished ? 0 : resource.data.roundMatchesPlayed + 1)
            && request.resource.data.roundRockCount == (finished ? 0 : resource.data.roundRockCount + (ownMove == 'ROCK' ? 1 : 0))
            && request.resource.data.roundPaperCount == (finished ? 0 : resource.data.roundPaperCount + (ownMove == 'PAPER' ? 1 : 0))
            && request.resource.data.roundScissorsCount == (finished ? 0 : resource.data.roundScissorsCount + (ownMove == 'SCISSORS' ? 1 : 0))
            && request.resource.data.lastPlayedAtEpochMs is int;
        }

        allow get: if activeUser() && (request.auth.uid == uid || currentRoomMember());
        allow list: if activeUser() && currentRoomMember();

        allow create: if activeUser()
          && request.auth.uid == uid
          && request.resource.data.uid == uid
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 80
          && getAfter(/databases/$(database)/documents/gameRooms/$(roomId)).data.memberUids.hasAny([uid])
          && (
            getAfter(/databases/$(database)/documents/gameRooms/$(roomId)).data.isPublic == true
            || (
              request.resource.data.get('joinedAsOwner', false) == true
              && getAfter(/databases/$(database)/documents/gameRooms/$(roomId)).data.ownerUid == uid
            )
            || (
              request.resource.data.get('joinedViaCode', '') is string
              && request.resource.data.joinedViaCode == getAfter(/databases/$(database)/documents/gameRooms/$(roomId)).data.get('inviteCode', '')
              && exists(/databases/$(database)/documents/gameRoomCodes/$(request.resource.data.joinedViaCode))
              && get(/databases/$(database)/documents/gameRoomCodes/$(request.resource.data.joinedViaCode)).data.roomId == roomId
            )
            || (
              request.resource.data.get('joinedViaInvitationId', '') is string
              && getAfter(/databases/$(database)/documents/gameRoomInvitations/$(uid)/items/$(request.resource.data.joinedViaInvitationId)).data.status == 'ACCEPTED'
              && getAfter(/databases/$(database)/documents/gameRoomInvitations/$(uid)/items/$(request.resource.data.joinedViaInvitationId)).data.roomId == roomId
            )
          );

        allow update: if activeUser() && (
          validOwnReadMarkerUpdate()
          || validResultStatsUpdate()
          || validRoundResetUpdate()
        );
        allow delete: if signedIn() && request.auth.uid == uid;
      }

      match /rounds/{roundId} {
        allow get, list: if activeUser() && currentRoomMember();
        allow create: if activeUser()
          && request.auth.uid in getAfter(/databases/$(database)/documents/gameRooms/$(roomId)).data.memberUids
          && request.resource.data.roundId == roundId
          && request.resource.data.status == 'ACTIVE'
          && request.resource.data.targetScore == getAfter(/databases/$(database)/documents/gameRooms/$(roomId)).data.targetScore
          && request.resource.data.roundNumber is int;
        allow update: if activeUser()
          && currentRoomMember()
          && resource.data.status == 'ACTIVE'
          && request.resource.data.status == 'FINISHED'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'winnerUid', 'winnerName', 'winningScore', 'finishedAtEpochMs'
          ])
          && request.resource.data.winningScore is int
          && request.resource.data.finishedAtEpochMs is int
          && existsAfter(/databases/$(database)/documents/gameRooms/$(roomId)/roundResults/$(roundId));
        allow delete: if activeUser()
          && currentRoomMember()
          && resource.data.status == 'FINISHED';
        
        match /pairs/{pairId} {
          function participantsInPair() {
            return request.resource.data.uidA is string
              && request.resource.data.uidB is string
              && request.resource.data.uidA != request.resource.data.uidB
              && request.resource.data.uidA in get(/databases/$(database)/documents/gameRooms/$(roomId)).data.memberUids
              && request.resource.data.uidB in get(/databases/$(database)/documents/gameRooms/$(roomId)).data.memberUids
              && request.auth.uid in [request.resource.data.uidA, request.resource.data.uidB];
          }

          allow get, list: if activeUser() && currentRoomMember();

          allow create: if activeUser()
            && currentRoomMember()
            && participantsInPair()
            && request.resource.data.status == 'WAITING'
            && request.resource.data.submittedUids is list
            && request.auth.uid in request.resource.data.submittedUids
            && request.resource.data.matchId is string
            && existsAfter(/databases/$(database)/documents/gameRooms/$(roomId)/rounds/$(roundId)/matches/$(request.resource.data.matchId)/moves/$(request.auth.uid));

          allow update: if activeUser()
            && currentRoomMember()
            && participantsInPair()
            && resource.data.uidA == request.resource.data.uidA
            && resource.data.uidB == request.resource.data.uidB
            && (
              (
                request.resource.data.status == 'WAITING'
                && request.resource.data.submittedUids is list
                && request.auth.uid in request.resource.data.submittedUids
                && existsAfter(/databases/$(database)/documents/gameRooms/$(roomId)/rounds/$(roundId)/matches/$(request.resource.data.matchId)/moves/$(request.auth.uid))
              )
              || (
                request.resource.data.status == 'RESOLVED'
                && getAfter(/databases/$(database)/documents/gameRooms/$(roomId)/rounds/$(roundId)/matches/$(request.resource.data.matchId)).data.status == 'RESOLVED'
                && request.resource.data.moveA is string
                && request.resource.data.moveB is string
                && request.resource.data.pointsA is int
                && request.resource.data.pointsB is int
              )
            );
          allow delete: if activeUser()
            && currentRoomMember()
            && get(/databases/$(database)/documents/gameRooms/$(roomId)/rounds/$(roundId)).data.status == 'FINISHED';
        }

        match /matches/{matchId} {
          function matchRoomMember() {
            return activeUser()
              && exists(/databases/$(database)/documents/gameRooms/$(roomId)/members/$(request.auth.uid));
          }

          function beats(moveA, moveB) {
            return (moveA == 'ROCK' && moveB == 'SCISSORS')
              || (moveA == 'SCISSORS' && moveB == 'PAPER')
              || (moveA == 'PAPER' && moveB == 'ROCK');
          }

          function expectedPoints(moveA, moveB) {
            return moveA == moveB ? 2 : (beats(moveA, moveB) ? 3 : 1);
          }

          allow get, list: if matchRoomMember();

          allow create: if matchRoomMember()
            && request.resource.data.matchId == matchId
            && request.resource.data.uidA is string
            && request.resource.data.uidB is string
            && request.resource.data.uidA != request.resource.data.uidB
            && request.auth.uid in [request.resource.data.uidA, request.resource.data.uidB]
            && request.resource.data.uidA in get(/databases/$(database)/documents/gameRooms/$(roomId)).data.memberUids
            && request.resource.data.uidB in get(/databases/$(database)/documents/gameRooms/$(roomId)).data.memberUids
            && request.resource.data.status == 'WAITING'
            && request.resource.data.createdAtEpochMs is int;

          allow update: if matchRoomMember()
            && resource.data.status == 'WAITING'
            && request.resource.data.status == 'RESOLVED'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'roundId', 'nameA', 'nameB', 'moveA', 'moveB', 'winnerUid',
              'pointsA', 'pointsB', 'scoreAfterA', 'scoreAfterB', 'targetScore',
              'roundFinished', 'resolvedAtEpochMs'
            ])
            && request.resource.data.uidA == resource.data.uidA
            && request.resource.data.uidB == resource.data.uidB
            && request.resource.data.roundId == roundId
            && request.auth.uid in [resource.data.uidA, resource.data.uidB]
            && get(/databases/$(database)/documents/gameRooms/$(roomId)/rounds/$(roundId)/matches/$(matchId)/moves/$(resource.data.uidA)).data.choice == request.resource.data.moveA
            && get(/databases/$(database)/documents/gameRooms/$(roomId)/rounds/$(roundId)/matches/$(matchId)/moves/$(resource.data.uidB)).data.choice == request.resource.data.moveB
            && request.resource.data.moveA in ['ROCK', 'PAPER', 'SCISSORS']
            && request.resource.data.moveB in ['ROCK', 'PAPER', 'SCISSORS']
            && request.resource.data.pointsA == expectedPoints(request.resource.data.moveA, request.resource.data.moveB)
            && request.resource.data.pointsB == expectedPoints(request.resource.data.moveB, request.resource.data.moveA)
            && request.resource.data.scoreAfterA == get(/databases/$(database)/documents/gameRooms/$(roomId)/members/$(resource.data.uidA)).data.score + request.resource.data.pointsA
            && request.resource.data.scoreAfterB == get(/databases/$(database)/documents/gameRooms/$(roomId)/members/$(resource.data.uidB)).data.score + request.resource.data.pointsB
            && request.resource.data.targetScore == get(/databases/$(database)/documents/gameRooms/$(roomId)/rounds/$(roundId)).data.targetScore
            && request.resource.data.roundFinished == (
              request.resource.data.scoreAfterA >= request.resource.data.targetScore
              || request.resource.data.scoreAfterB >= request.resource.data.targetScore
            )
            && request.resource.data.winnerUid == (
              !request.resource.data.roundFinished ? null :
                (request.resource.data.scoreAfterA >= request.resource.data.scoreAfterB
                  ? resource.data.uidA : resource.data.uidB)
            )
            && request.resource.data.winnerName == (
              request.resource.data.winnerUid == resource.data.uidA ? request.resource.data.nameA :
                (request.resource.data.winnerUid == resource.data.uidB ? request.resource.data.nameB : null)
            )
            && getAfter(/databases/$(database)/documents/gameRooms/$(roomId)/members/$(resource.data.uidA)).data.score == (request.resource.data.roundFinished ? 0 : request.resource.data.scoreAfterA)
            && getAfter(/databases/$(database)/documents/gameRooms/$(roomId)/members/$(resource.data.uidB)).data.score == (request.resource.data.roundFinished ? 0 : request.resource.data.scoreAfterB)
            && request.resource.data.resolvedAtEpochMs is int;

          allow delete: if activeUser()
            && matchRoomMember()
            && get(/databases/$(database)/documents/gameRooms/$(roomId)/rounds/$(roundId)).data.status == 'FINISHED';

          match /moves/{uid} {
            function parentMatch() {
              return get(/databases/$(database)/documents/gameRooms/$(roomId)/rounds/$(roundId)/matches/$(matchId)).data;
            }

            allow get: if activeUser()
              && (
                request.auth.uid == uid
                || (
                  matchRoomMember()
                  && exists(/databases/$(database)/documents/gameRooms/$(roomId)/rounds/$(roundId)/matches/$(matchId)/moves/$(request.auth.uid))
                )
              );
            allow list: if false;
            allow create: if activeUser()
              && request.auth.uid == uid
              && matchRoomMember()
              && request.resource.data.uid == uid
              && request.resource.data.choice in ['ROCK', 'PAPER', 'SCISSORS']
              && request.resource.data.createdAtEpochMs is int
              && getAfter(/databases/$(database)/documents/gameRooms/$(roomId)/rounds/$(roundId)/matches/$(matchId)).data.status == 'WAITING'
              && uid in [
                getAfter(/databases/$(database)/documents/gameRooms/$(roomId)/rounds/$(roundId)/matches/$(matchId)).data.uidA,
                getAfter(/databases/$(database)/documents/gameRooms/$(roomId)/rounds/$(roundId)/matches/$(matchId)).data.uidB
              ];
            allow update: if false;
            allow delete: if activeUser()
              && matchRoomMember()
              && getAfter(/databases/$(database)/documents/gameRooms/$(roomId)/rounds/$(roundId)/matches/$(matchId)).data.status == 'RESOLVED';
          }
        }
      }

      match /messages/{messageId} {
        allow get, list: if activeUser() && currentRoomMember();
        allow create: if activeUser()
          && currentRoomMember()
          && request.resource.data.keys().hasOnly(['senderUid', 'senderName', 'text', 'createdAtEpochMs'])
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() <= 80
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.createdAtEpochMs is int;
        allow update: if false;
        allow delete: if activeUser() && currentRoomMember();
      }

      match /chatState/{summaryId} {
        allow get, list: if activeUser() && currentRoomMember();
        allow create, update: if activeUser()
          && currentRoomMember()
          && summaryId == 'summary'
          && request.resource.data.keys().hasOnly(['lastMessageAtEpochMs'])
          && request.resource.data.lastMessageAtEpochMs is int;
        allow delete: if false;
      }

      match /roundResults/{roundId} {
        allow get, list: if activeUser() && currentRoomMember();
        allow create: if activeUser()
          && request.auth.uid in getAfter(/databases/$(database)/documents/gameRooms/$(roomId)).data.memberUids
          && request.resource.data.keys().hasOnly([
            'roundId', 'winnerUid', 'winnerName', 'winningScore', 'scoreAfterA',
            'scoreAfterB', 'targetScore', 'triggerMatchId', 'finishedAtEpochMs', 'isDraw'
          ])
          && request.resource.data.roundId == roundId
          && request.resource.data.triggerMatchId is string
          && existsAfter(/databases/$(database)/documents/gameRooms/$(roomId)/rounds/$(roundId)/matches/$(request.resource.data.triggerMatchId))
          && getAfter(/databases/$(database)/documents/gameRooms/$(roomId)/rounds/$(roundId)/matches/$(request.resource.data.triggerMatchId)).data.status == 'RESOLVED'
          && getAfter(/databases/$(database)/documents/gameRooms/$(roomId)/rounds/$(roundId)/matches/$(request.resource.data.triggerMatchId)).data.roundFinished == true
          && request.resource.data.winnerUid == getAfter(/databases/$(database)/documents/gameRooms/$(roomId)/rounds/$(roundId)/matches/$(request.resource.data.triggerMatchId)).data.winnerUid
          && request.resource.data.winnerName == getAfter(/databases/$(database)/documents/gameRooms/$(roomId)/rounds/$(roundId)/matches/$(request.resource.data.triggerMatchId)).data.winnerName
          && request.resource.data.winningScore == (
            getAfter(/databases/$(database)/documents/gameRooms/$(roomId)/rounds/$(roundId)/matches/$(request.resource.data.triggerMatchId)).data.scoreAfterA
              >= getAfter(/databases/$(database)/documents/gameRooms/$(roomId)/rounds/$(roundId)/matches/$(request.resource.data.triggerMatchId)).data.scoreAfterB
              ? getAfter(/databases/$(database)/documents/gameRooms/$(roomId)/rounds/$(roundId)/matches/$(request.resource.data.triggerMatchId)).data.scoreAfterA
              : getAfter(/databases/$(database)/documents/gameRooms/$(roomId)/rounds/$(roundId)/matches/$(request.resource.data.triggerMatchId)).data.scoreAfterB
          )
          && request.resource.data.scoreAfterA == getAfter(/databases/$(database)/documents/gameRooms/$(roomId)/rounds/$(roundId)/matches/$(request.resource.data.triggerMatchId)).data.scoreAfterA
          && request.resource.data.scoreAfterB == getAfter(/databases/$(database)/documents/gameRooms/$(roomId)/rounds/$(roundId)/matches/$(request.resource.data.triggerMatchId)).data.scoreAfterB
          && request.resource.data.targetScore == getAfter(/databases/$(database)/documents/gameRooms/$(roomId)/rounds/$(roundId)/matches/$(request.resource.data.triggerMatchId)).data.targetScore
          && request.resource.data.finishedAtEpochMs == getAfter(/databases/$(database)/documents/gameRooms/$(roomId)/rounds/$(roundId)/matches/$(request.resource.data.triggerMatchId)).data.resolvedAtEpochMs
          && request.resource.data.isDraw == (request.resource.data.winnerUid == null);
        allow update: if false;
        allow delete: if false;
      }
    }

    match /gameRoomCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if activeUser()
        && validInviteCode(code)
        && request.resource.data.keys().hasOnly(['roomId'])
        && request.resource.data.roomId is string
        && getAfter(/databases/$(database)/documents/gameRooms/$(request.resource.data.roomId)).data.ownerUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/gameRooms/$(request.resource.data.roomId)).data.inviteCode == code;
      allow update: if false;
      allow delete: if canDeleteOwnData(request.auth.uid)
        && (
          !existsAfter(/databases/$(database)/documents/gameRooms/$(resource.data.roomId))
          || getAfter(/databases/$(database)/documents/gameRooms/$(resource.data.roomId)).data.inviteCode != code
        );
    }

    match /gameRoomMemberships/{uid}/rooms/{roomId} {
      allow get, list: if canAccessOwnData(uid);
      allow create, update: if activeUser()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['roomId', 'joinedAtEpochMs'])
        && request.resource.data.roomId == roomId
        && request.resource.data.joinedAtEpochMs is int
        && existsAfter(/databases/$(database)/documents/gameRooms/$(roomId)/members/$(uid));
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /gameRoomInvitations/{recipientUid}/items/{invitationId} {
      allow get, list: if canAccessOwnData(recipientUid);
      allow create: if activeUser()
        && request.resource.data.keys().hasOnly([
          'invitationId', 'roomId', 'roomName', 'inviterUid', 'inviterName',
          'createdAtEpochMs', 'status'
        ])
        && request.resource.data.invitationId == invitationId
        && request.resource.data.roomId is string
        && request.resource.data.roomName is string
        && request.resource.data.roomName.size() <= 40
        && request.resource.data.inviterUid == request.auth.uid
        && request.resource.data.inviterName is string
        && request.resource.data.inviterName.size() <= 80
        && request.resource.data.createdAtEpochMs is int
        && request.resource.data.status == 'PENDING'
        && exists(/databases/$(database)/documents/gameRooms/$(request.resource.data.roomId))
        && get(/databases/$(database)/documents/gameRooms/$(request.resource.data.roomId)).data.ownerUid is string
        && request.auth.uid in get(/databases/$(database)/documents/gameRooms/$(request.resource.data.roomId)).data.memberUids
        && !(recipientUid in get(/databases/$(database)/documents/gameRooms/$(request.resource.data.roomId)).data.memberUids)
        && recipientUid != request.auth.uid
        && exists(/databases/$(database)/documents/publicProfiles/$(recipientUid))
        && !exists(/databases/$(database)/documents/deletedProfiles/$(recipientUid))
        && !exists(/databases/$(database)/documents/blockedUsers/$(request.auth.uid)/users/$(recipientUid))
        && !exists(/databases/$(database)/documents/blockedUsers/$(recipientUid)/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/gameRooms/$(request.resource.data.roomId)).data.memberUids.size()
          < get(/databases/$(database)/documents/gameRooms/$(request.resource.data.roomId)).data.maxParticipants;
      allow update: if activeUser()
        && request.auth.uid == recipientUid
        && resource.data.status == 'PENDING'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAtEpochMs'])
        && request.resource.data.status in ['ACCEPTED', 'DECLINED']
        && request.resource.data.respondedAtEpochMs is int
        && (
          request.resource.data.status != 'ACCEPTED'
          || (
            existsAfter(/databases/$(database)/documents/gameRooms/$(resource.data.roomId)/members/$(recipientUid))
            && recipientUid in getAfter(/databases/$(database)/documents/gameRooms/$(resource.data.roomId)).data.memberUids
          )
        );
      allow delete: if canDeleteOwnData(recipientUid)
        || (signedIn() && resource.data.inviterUid == request.auth.uid);
    }

    match /gameRoomNotifications/{uid}/items/{notificationId} {
      allow get, list: if canAccessOwnData(uid);
      allow create: if activeUser()
        && request.resource.data.keys().hasOnly([
          'roomId', 'roundId', 'roomName', 'winnerUid', 'winnerName',
          'winningScore', 'finishedAtEpochMs', 'status'
        ])
        && request.resource.data.roomId is string
        && request.resource.data.roundId is string
        && request.resource.data.roomName is string
        && request.resource.data.winningScore is int
        && request.resource.data.finishedAtEpochMs is int
        && request.resource.data.status == 'UNREAD'
        && exists(/databases/$(database)/documents/gameRooms/$(request.resource.data.roomId)/members/$(uid));
      allow update: if canAccessOwnData(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'READ';
      allow delete: if canDeleteOwnData(uid);
    }

    // Gifts are immutable deliveries. The client may retry the same gift ID, but cannot
    // alter a delivery after creation. The recipient alone can read the inbox.
    match /giftDeliveries/{recipientUid}/items/{giftId} {
      function validGiftPayload() {
        return request.resource.data.keys().hasOnly([
          'giftId', 'senderUid', 'senderName', 'recipientUid',
          'giftType', 'amount', 'createdAtEpochMs'
        ])
          && request.resource.data.giftId == giftId
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() <= 80
          && request.resource.data.recipientUid == recipientUid
          && request.resource.data.giftType is string
          && request.resource.data.amount is int
          && (
            (request.resource.data.giftType == 'CANDY' && request.resource.data.amount == 10)
            || (request.resource.data.giftType == 'COFFEE' && request.resource.data.amount == 20)
            || (request.resource.data.giftType == 'CROISSANT' && request.resource.data.amount == 30)
            || (request.resource.data.giftType == 'HAMBURGER' && request.resource.data.amount == 40)
            || (request.resource.data.giftType == 'CAKE' && request.resource.data.amount == 50)
            || (
              request.resource.data.giftType in [
                'COSMETIC:COSTUME:spacesuit',
                'COSMETIC:COSTUME:matryoshka',
                'COSMETIC:COSTUME:square_sponge',
                'COSMETIC:COSTUME:croissant',
                'COSMETIC:COSTUME:bear',
                'COSMETIC:BACKGROUND:pyramids',
                'COSMETIC:BACKGROUND:forest',
                'COSMETIC:BACKGROUND:beach',
                'COSMETIC:BACKGROUND:office',
                'COSMETIC:BACKGROUND:snow_mountains'
              ]
              && request.resource.data.amount == 100
            )
          )
          && request.resource.data.createdAtEpochMs is int;
      }

      allow get, list: if canAccessOwnData(recipientUid);
      allow create: if activeUser()
        && request.auth.uid != recipientUid
        && validGiftPayload()
        && exists(/databases/$(database)/documents/publicProfiles/$(recipientUid))
        && !exists(/databases/$(database)/documents/deletedProfiles/$(recipientUid))
        && exists(/databases/$(database)/documents/follows/$(request.auth.uid + '_' + recipientUid))
        && !exists(/databases/$(database)/documents/blockedUsers/$(request.auth.uid)/users/$(recipientUid))
        && !exists(/databases/$(database)/documents/blockedUsers/$(recipientUid)/users/$(request.auth.uid));
      allow update: if activeUser()
        && resource.data.senderUid == request.auth.uid
        && request.resource.data == resource.data;
      allow delete: if canDeleteOwnData(recipientUid);
    }
  }
}
